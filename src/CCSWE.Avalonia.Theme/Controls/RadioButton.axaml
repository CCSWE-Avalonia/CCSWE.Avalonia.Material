<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.6.0
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 RadioButton. 20dp outer ring, 2px Outline-variant border when
  unselected; selected shows a Primary ring + a 10dp Primary inner dot. 40dp
  circular state layer behind. Default RadioButton theme (no class needed).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid ColumnDefinitions="Auto,*">
          <Panel Grid.Column="0" Width="40" Height="40">
            <Border x:Name="StateLayer" Width="40" Height="40" CornerRadius="20"
                    Background="{DynamicResource OnSurface}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <Ellipse x:Name="OuterRing" Width="20" Height="20"
                     Stroke="{DynamicResource OnSurfaceVariant}" StrokeThickness="2"
                     Fill="Transparent" />
            <Ellipse x:Name="InnerDot" Width="10" Height="10"
                     Fill="{DynamicResource Primary}" IsVisible="False" />
          </Panel>
          <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Ellipse#OuterRing">
      <Setter Property="Stroke" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#InnerDot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:pressed /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>

    <!-- Disabled: neutral recolor (NOT a whole-element opacity dim). Ring -> OnSurface12,
         inner dot + label -> OnSurface38, so a disabled SELECTED radio reads M3 gray. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#OuterRing">
      <Setter Property="Stroke" Value="{DynamicResource OnSurface12}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#InnerDot">
      <Setter Property="Fill" Value="{DynamicResource OnSurface38}" />
    </Style>
  </ControlTheme>
  </Styles.Resources>

</Styles>

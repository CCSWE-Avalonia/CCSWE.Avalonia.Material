<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.7.1
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 tree. Mirrors the ListBox/ListBoxItem treatment (ListBox.axaml) for
  the row, plus an expand/collapse chevron and per-level indentation:

    - TreeView      - transparent container, no border, ScrollViewer + items.
    - TreeViewItem  - the M3 list row: 48dp min height, OnSurface state layer
                      (hover .08 / pressed .10), selected = SecondaryContainer /
                      OnSecondaryContainer. Adds PART_ExpandCollapseChevron (an
                      OnSurfaceVariant caret that rotates 90 degrees on :expanded
                      over MotionDurationShort2) and 24dp-per-level indentation
                      via Avalonia's MarginMultiplierConverter on TreeViewItem.Level.

  The chevron is a ToggleButton given its OWN local template so it opts out of the
  M3 pill ToggleButton theme (ToggleButton.axaml). Default themes (no class).

  NOTE: TreeViewItem derives from HeaderedItemsControl (NOT ContentControl), so it
  has no Vertical/HorizontalContentAlignment property. Do NOT carry those setters
  over when cloning ListBoxItem -> they raise AVLN2000. The header ContentPresenter
  hardcodes VerticalAlignment="Center", so the setter was dead anyway. (1.5.1 fix.)
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls">

  <Styles.Resources>

    <!-- 24dp per nesting level (M3), applied as a left margin on the row. -->
    <converters:MarginMultiplierConverter x:Key="CcsweTreeIndentConverter" Indent="24" Left="True" />

    <ControlTheme x:Key="{x:Type TreeView}" TargetType="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TreeView">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ScrollViewer x:Name="PART_ScrollViewer"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="{TemplateBinding Padding}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="8,12,16,12" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Border x:Name="PART_LayoutRoot" MinHeight="{TemplateBinding MinHeight}"
                    Margin="{TemplateBinding Level, Converter={StaticResource CcsweTreeIndentConverter}}">
              <Panel>
                <Border x:Name="SelectedLayer" CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Background="{DynamicResource SecondaryContainer}" Opacity="0" />
                <Border x:Name="StateLayer" CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Background="{DynamicResource OnSurface}" Opacity="0">
                  <Border.Transitions>
                    <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
                  </Border.Transitions>
                </Border>
                <Grid ColumnDefinitions="Auto,*">
                  <ToggleButton x:Name="PART_ExpandCollapseChevron" Grid.Column="0"
                                Background="Transparent" BorderThickness="0"
                                Width="32" Height="32" Padding="0"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform"
                                                       Duration="{DynamicResource MotionDurationShort2}"
                                                       Easing="{DynamicResource MotionEasingStandard}" />
                      </Transitions>
                    </ToggleButton.Transitions>
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                          <Path Width="8" Height="12" Stretch="Uniform"
                                Fill="{DynamicResource OnSurfaceVariant}"
                                Data="M0,0 L8,6 L0,12 Z"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" x:Name="PART_HeaderPresenter"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                </Grid>
              </Panel>
            </Border>
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:selected /template/ Border#SelectedLayer">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <Style Selector="^:expanded /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
      <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <!-- Disabled: recolor (header OnSurface38, chevron OnSurface38, selected fill
           OnSurface12), not a whole-element opacity dim. -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ ToggleButton#PART_ExpandCollapseChevron Path">
        <Setter Property="Fill" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:selected:disabled /template/ Border#SelectedLayer">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>
</Styles>

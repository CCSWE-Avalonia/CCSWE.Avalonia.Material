<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.5.3
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 numeric stepper. A NumericUpDown hosts an inner ButtonSpinner (which
  owns the field chrome + the two RepeatButton spinners) wrapping a TextBox. So
  three themes ride here:

    - NumericUpDown   - hosts PART_Spinner (ButtonSpinner) + PART_TextBox; passes
                        AllowSpin / ShowButtonSpinner / ButtonSpinnerLocation
                        through. The visible chrome is the ButtonSpinner.
    - ButtonSpinner   - the M3 Outlined field box (1px Outline, CornerRadiusExtraSmall,
                        -> 2px Primary on :focus-within, Error on :error), with the
                        up/down spinner buttons (PART_IncreaseButton /
                        PART_DecreaseButton) as OnSurfaceVariant caret RepeatButtons
                        carrying a circular state layer (.08 / .10).
    - CcsweEmbeddedTextBox - a transparent, borderless TextBox theme for the inner
                        field, so the ButtonSpinner draws the single outline (no
                        double border). Primary caret, PrimaryContainer selection.

  The inner field is NOT given Classes="Outlined" (that would double the border);
  it uses the embedded theme. Honors required parts: NumericUpDown PART_Spinner /
  PART_TextBox; ButtonSpinner PART_IncreaseButton / PART_DecreaseButton.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <!-- Transparent borderless inner field (the ButtonSpinner owns the outline). -->
    <ControlTheme x:Key="CcsweEmbeddedTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryContainer}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnPrimaryContainer}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TextBox">
          <Panel>
            <Border x:Name="PART_BorderElement" Background="Transparent" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{TemplateBinding Padding}">
              <ContentPresenter Grid.Column="0" Content="{TemplateBinding InnerLeftContent}" VerticalAlignment="Center" />
              <ScrollViewer Grid.Column="1" x:Name="PART_ScrollViewer"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <Panel>
                  <TextBlock x:Name="PART_Watermark"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             IsVisible="False" VerticalAlignment="Center" />
                  <TextPresenter x:Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 VerticalAlignment="Center" />
                </Panel>
              </ScrollViewer>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}" VerticalAlignment="Center" />
            </Grid>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:empty /template/ TextBlock#PART_Watermark">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <!-- Disabled: recolor the number text + watermark to OnSurface38 (the embedded
           field sets its own Foreground, so an outer TextElement.Foreground can't reach it). -->
      <Style Selector="^:disabled /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>

    <!-- Spinner RepeatButton: transparent, circular state layer, caret as Content. -->
    <ControlTheme x:Key="CcsweSpinnerButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="RepeatButton">
          <Panel Background="Transparent">
            <Border x:Name="StateLayer" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource OnSurfaceVariant}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
    </ControlTheme>

    <!-- ButtonSpinner: the M3 Outlined field box + stacked spinner buttons. -->
    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusExtraSmall}" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ButtonSpinner">
          <!-- OVERLAY structure: PART_BorderElement is an EMPTY sibling of the content
               Grid inside a Panel, so :focus-within thickening it 1->2 is paint-only and
               the field content does NOT reflow (container-border rule, see CONVENTIONS).
               The field's 16px text padding + the spinner's 6px margin clear the 2px border. -->
          <Panel>
            <Border x:Name="PART_BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <StackPanel Grid.Column="2" x:Name="PART_SpinnerPanel"
                          Orientation="Vertical" Spacing="0"
                          VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
                <RepeatButton x:Name="PART_IncreaseButton" Theme="{StaticResource CcsweSpinnerButton}">
                  <Path Width="10" Height="6" Stretch="Uniform"
                        Fill="{DynamicResource OnSurfaceVariant}"
                        Data="M0,6 L5,0 L10,6 Z" />
                </RepeatButton>
                <RepeatButton x:Name="PART_DecreaseButton" Theme="{StaticResource CcsweSpinnerButton}">
                  <Path Width="10" Height="6" Stretch="Uniform"
                        Fill="{DynamicResource OnSurfaceVariant}"
                        Data="M0,0 L5,6 L10,0 Z" />
                </RepeatButton>
              </StackPanel>
            </Grid>
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource OnSurface}" />
      </Style>
      <Style Selector="^:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <!-- Error LAST so it beats :focus-within (red wins). Matches both the inherent
           :error pseudo AND the `.error` style class forwarded from the NumericUpDown's
           own validation (the outer control's :error doesn't reach this inner spinner). -->
      <Style Selector="^:error /template/ Border#PART_BorderElement, ^.error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
      </Style>
      <!-- Honor ButtonSpinnerLocation=Left: move the spinner to the leading column. -->
      <Style Selector="^[ButtonSpinnerLocation=Left] /template/ StackPanel#PART_SpinnerPanel">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Margin" Value="6,0,0,0" />
      </Style>
      <!-- Disabled: neutral recolor (outline OnSurface12, carets OnSurface38), not a dim. -->
      <Style Selector="^:disabled /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource OnSurface12}" />
      </Style>
      <Style Selector="^:disabled /template/ StackPanel#PART_SpinnerPanel Path">
        <Setter Property="Fill" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>

    <!-- NumericUpDown: hosts the ButtonSpinner + the embedded TextBox. -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="NumericUpDown">
          <ButtonSpinner x:Name="PART_Spinner"
                         MinHeight="{TemplateBinding MinHeight}"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         AllowSpin="{TemplateBinding AllowSpin}"
                         ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                         ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                         Classes.error="{Binding (DataValidationErrors.HasErrors), RelativeSource={RelativeSource TemplatedParent}}">
            <TextBox x:Name="PART_TextBox"
                     Theme="{StaticResource CcsweEmbeddedTextBox}"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding Watermark}"
                     VerticalContentAlignment="Center" />
          </ButtonSpinner>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Styles.Resources>
</Styles>

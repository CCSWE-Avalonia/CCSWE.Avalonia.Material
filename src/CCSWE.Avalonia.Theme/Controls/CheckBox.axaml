<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.7.1
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 CheckBox. 18dp box, 2px Outline-variant border when unchecked,
  fills Primary with an OnPrimary checkmark when checked, 2px corner radius.
  A 40dp circular state layer (the box/primary color at hover .08 / pressed .10)
  sits behind the box. Applied as the default CheckBox theme (no class needed).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Grid ColumnDefinitions="Auto,*">
          <Panel Grid.Column="0" Width="40" Height="40">
            <Border x:Name="StateLayer" Width="40" Height="40" CornerRadius="20"
                    Background="{DynamicResource OnSurface}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="2"
                    BorderThickness="2" BorderBrush="{DynamicResource OnSurfaceVariant}"
                    Background="Transparent">
              <Path x:Name="CheckGlyph"
                    Stroke="{DynamicResource OnPrimary}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M3,8 L6.5,11.5 L13,4" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Panel>
          <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
    </Style>

    <!-- indeterminate: filled box, horizontal bar glyph reused as a dash -->
    <Style Selector="^:indeterminate /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="M3,8 L13,8" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:pressed /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>

    <!-- Disabled: neutral recolor (NOT a whole-element opacity dim), so a disabled
         CHECKED box reads as M3 gray rather than a faded brand tint. Outline/fill
         -> OnSurface12, glyph + label -> OnSurface38. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface12}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#CheckGlyph">
      <Setter Property="Stroke" Value="{DynamicResource OnSurface38}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#Box, ^:indeterminate:disabled /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface12}" />
    </Style>
  </ControlTheme>
  </Styles.Resources>

</Styles>

<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.7.0
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 Navigation Drawer + Rail for Avalonia 12's DrawerPage (built on
  SplitView). DrawerPage is a *container* - it supplies a drawer pane slot + main
  content slot and the open/dock/overlay/compact layout, but ships NO navigation-
  item model. So this file delivers THREE things:

    A) M3NavigationDrawerItem  - the M3 drawer destination (the signature). A
       ListBoxItem ControlTheme: 56dp full-pill row, OnSurfaceVariant inactive;
       active (:selected) fills SecondaryContainer / OnSecondaryContainer; OnSurface
       state layer at .08/.10 (OnSecondaryContainer when active). Applied by the host
       ListBox via ItemContainerTheme - KEYED (M3NavigationDrawerItem), so it does
       NOT collide with the global {x:Type ListBoxItem} owned by ListBox.axaml.
       Consumer supplies icon + label as item content (the bundle ships no icons).

    A2) M3NavigationRailItem  - the M3 RAIL destination (compact, icon-over-label),
       for DrawerPage's CompactInline/CompactOverlay (80dp) modes (avalonia-nav-rail-
       spec.md). NOT a width variant of the drawer item: the active-indicator pill
       wraps the ICON ONLY (56x32), the label sits BELOW it, and active colors icon
       and label DIFFERENTLY (icon OnSecondaryContainer, label OnSurface) - so the
       single TextElement.Foreground cascade the drawer uses can't work; icon and
       label recolor on SEPARATE targets. Content contract (no C# to split a single
       ListBoxItem.Content): Content = the icon, Tag = the label string. Keyed +
       applied via ItemContainerTheme by ListBox.NavigationRail. Control count stays
       19 (rail rides in this same file as the drawer's compact sibling).

    B) DrawerPage container defaults - pane/header/footer surface, the modal scrim,
       and the M3 pane/rail widths.

  Why B is a Style, not a ControlTheme: FluentTheme already ships the DrawerPage
  ControlTheme (template + the 9 PART_* parts + open/dock/overlay animation). A
  ControlTheme x:Key="{x:Type DrawerPage}" here would REPLACE it and, with no way
  to BasedOn Fluent's internal key, drop the template. A Style Selector="DrawerPage"
  instead LAYERS token-driven property defaults over Fluent's template - non-
  destructive (instance/local values still win) and keeps the working template.
  The DrawerPage public surface (DrawerBackground / DrawerHeaderBackground /
  DrawerFooterBackground / *Foreground / BackdropBrush / DrawerLength /
  CompactDrawerLength) is verified against the Avalonia source; the 9 template
  parts are all non-required [TemplatePart] (the control null-guards every Find<>),
  so layering needs none of them.

  Design decisions (from avalonia-nav-drawer-spec.md open questions):
    1. Pane surface = SurfaceContainerLow (bundle's elevated-surface choice, cf.
       Expander; reads better on the dark scheme than raw M3 `Surface`).
    2. DrawerLength defaulted to M3's 360 (Avalonia default 320), CompactDrawerLength
       to the M3 rail's 80 (Avalonia default 48) - non-destructive property defaults.
    3. Destinations modeled as a single-select ListBox (matches the AutoCompleteBox
       items-host precedent - a templated, container-generating type).
    4. Navigation RAIL (compact, icon-over-label) shipped 1.7.0 as M3NavigationRailItem
       + ListBox.NavigationRail (avalonia-nav-rail-spec.md). Open questions resolved:
       Content=icon / Tag=label contract (no C#); active label = OnSurface (the one
       place the rail diverges from the drawer); labels always shown (drawer parity).
    5. Trailing-edge divider (avalonia-integration-1.6.0.md follow-up): the docked
       drawer/rail wants a 1dp OutlineVariant divider on its trailing edge. DrawerPage
       exposes NO border property (the verified public surface above is pane/header/
       footer Background + *Foreground + BackdropBrush + lengths only - SplitView, its
       base, has PaneBackground but no pane-border brush), so the divider CANNOT be
       layered by a property Setter the way DrawerBackground is. Reaching into Fluent's
       internal pane-root Border by part name is rejected (CONVENTIONS: the bundle does
       not depend on Fluent's non-contract internal part names). DS decision: REQUEST
       DrawerBorderBrush/DrawerBorderThickness upstream so a future cycle sets it here
       keyed off DrawerPlacement (one container-level concern, no per-consumer drift);
       until then the consumer draws a 1dp Border between pane and content in docked
       modes (the single blessed interim pattern - see HANDOFF). NOT emitted this cycle.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <!-- A) The M3 navigation-drawer destination. KEYED (not {x:Type ListBoxItem}). -->
    <ControlTheme x:Key="M3NavigationDrawerItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="56" />
      <!-- Side inset 12dp (pill sits in from the pane edge) + 2dp vertical = 4dp item gap. -->
      <Setter Property="Margin" Value="12,2" />
      <!-- Leading pad 16 -> icon; trailing pad 24 (badge room). Icon size + the 12dp
           icon->label gap are consumer content (e.g. StackPanel Spacing=12). -->
      <Setter Property="Padding" Value="16,0,24,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Panel>
            <!-- Active indicator = a full-pill SecondaryContainer fill (constant size;
                 only its Opacity toggles, so selection can't reflow the row). -->
            <Border x:Name="SelectedLayer" CornerRadius="{DynamicResource CornerRadiusFull}"
                    Background="{DynamicResource SecondaryContainer}" Opacity="0" />
            <Border x:Name="StateLayer" CornerRadius="{DynamicResource CornerRadiusFull}"
                    Background="{DynamicResource OnSurface}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <!-- TextElement.Foreground here recolors BOTH the label and a PathIcon
                 (icons paint from the inherited Foreground) together on :selected. -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              TextElement.Foreground="{DynamicResource OnSurfaceVariant}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:selected /template/ Border#SelectedLayer">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <!-- Active row's state layer reads against the SecondaryContainer fill. -->
      <Style Selector="^:selected /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <!-- Disabled: recolor (content OnSurface38, active fill OnSurface12), not an opacity dim. -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:selected:disabled /template/ Border#SelectedLayer">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      </Style>
    </ControlTheme>

    <!-- A2) The M3 navigation-RAIL destination (compact, icon-over-label). KEYED.
         Content = the icon; Tag = the label string (the no-C# split, see header). -->
    <ControlTheme x:Key="M3NavigationRailItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <!-- 56dp min touch target; 6dp top/bottom -> 12dp item-to-item gap. -->
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 56x32 active-indicator pill wraps the ICON ONLY (M3 rail). Constant
                 size; only SelectedLayer.Opacity toggles, so selection can't reflow.
                 State layer is clipped to this 56x32 box, not the whole item. -->
            <Panel Width="56" Height="32" HorizontalAlignment="Center">
              <Border x:Name="SelectedLayer" CornerRadius="{DynamicResource CornerRadiusFull}"
                      Background="{DynamicResource SecondaryContainer}" Opacity="0" />
              <Border x:Name="StateLayer" CornerRadius="{DynamicResource CornerRadiusFull}"
                      Background="{DynamicResource OnSurface}" Opacity="0">
                <Border.Transitions>
                  <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
                </Border.Transitions>
              </Border>
              <!-- Icon = item Content (24dp, consumer-supplied). TextElement.Foreground
                   recolors a PathIcon on :selected, INDEPENDENT of the label below. -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextElement.Foreground="{DynamicResource OnSurfaceVariant}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
            <!-- Label = item Tag (stringly-typed; flagged in HANDOFF). Label Medium,
                 centered, <=2 lines, 4dp below the indicator. Recolors on its OWN
                 target -> OnSurface when active (the rail's one divergence from the
                 drawer, where label = OnSecondaryContainer). -->
            <TextBlock x:Name="RailLabel" Text="{TemplateBinding Tag}"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       FontSize="12" FontWeight="Medium" LineHeight="16"
                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                       Margin="0,4,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <!-- Active: indicator fills SecondaryContainer; icon -> OnSecondaryContainer;
           label -> OnSurface (NOT OnSecondaryContainer - rail label diverges). -->
      <Style Selector="^:selected /template/ Border#SelectedLayer">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:selected /template/ TextBlock#RailLabel">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      </Style>
      <!-- Active row's state layer reads against the SecondaryContainer fill. -->
      <Style Selector="^:selected /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <!-- Disabled: neutral recolor (icon + label OnSurface38, active fill OnSurface12),
           never an opacity dim. Both content targets recolor; :disabled is listed after
           :selected so it wins source-order on a selected-and-disabled item. -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#RailLabel">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:selected:disabled /template/ Border#SelectedLayer">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!-- Host: ListBox Classes="NavigationDrawer" wears the destination treatment. -->
  <Style Selector="ListBox.NavigationDrawer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource M3NavigationDrawerItem}" />
  </Style>

  <!-- Host: ListBox Classes="NavigationRail" wears the compact rail treatment. Width
       is supplied by DrawerPage's CompactDrawerLength (80dp) - the host fills it.
       12dp rail end padding; the 12dp item-to-item gap rides on each item's Margin. -->
  <Style Selector="ListBox.NavigationRail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource M3NavigationRailItem}" />
  </Style>

  <!-- B) DrawerPage container: token-driven property defaults layered over Fluent's
       template (see header). Verified property names against the Avalonia source. -->
  <Style Selector="DrawerPage">
    <Setter Property="DrawerBackground" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="DrawerHeaderBackground" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="DrawerFooterBackground" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="DrawerHeaderForeground" Value="{DynamicResource OnSurface}" />
    <Setter Property="DrawerFooterForeground" Value="{DynamicResource OnSurface}" />
    <!-- Modal/overlay scrim = Scrim @ 32% (new Scrim32 token). -->
    <Setter Property="BackdropBrush" Value="{DynamicResource Scrim32}" />
    <!-- M3 widths (non-destructive; consumers can still set per-instance). -->
    <Setter Property="DrawerLength" Value="360" />
    <Setter Property="CompactDrawerLength" Value="80" />
  </Style>

</Styles>

<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.7.1
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 Expander. SurfaceContainerLow container, 12px radius; a full-width
  header (its own toggle theme, with a state layer + chevron that flips on
  expand) over a collapsible content area. Default theme (no class). Targets the
  common Down direction. The inner header toggle theme is private to this file.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <!-- Private header toggle look. -->
    <ControlTheme x:Key="CcsweExpanderToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Panel>
            <Border x:Name="StateLayer" Background="{DynamicResource OnSurface}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
              <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
              <Path x:Name="Chevron" Grid.Column="1" Width="12" Height="8" Stretch="Uniform"
                    Fill="{DynamicResource OnSurfaceVariant}" Data="M0,0 L12,0 L6,8 Z"
                    VerticalAlignment="Center" RenderTransformOrigin="50%,50%" Margin="16,0,0,0">
                <Path.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{DynamicResource MotionDurationShort2}"
                                                   Easing="{DynamicResource MotionEasingStandard}" />
                  </Transitions>
                </Path.Transitions>
              </Path>
            </Grid>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <!-- Chevron flips smoothly via the transform-operations transition above. -->
      <Style Selector="^:checked /template/ Path#Chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
      </Style>
      <!-- Disabled: recolor header label + chevron to OnSurface38 (not an opacity dim). -->
      <Style Selector="^:disabled /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ Path#Chevron">
        <Setter Property="Fill" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>

    <!-- Expander -->
    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Expander">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <ToggleButton x:Name="PART_toggle" DockPanel.Dock="Top"
                            Theme="{StaticResource CcsweExpanderToggle}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="16,0,16,16"
                                IsVisible="{TemplateBinding IsExpanded}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- Disabled: recolor the expanded content to OnSurface38 (the header toggle
           recolors itself); not a whole-element opacity dim. -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>
</Styles>

<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.5.3
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 Card convention. Avalonia has no stock `Card`; M3 cards are a styled
  Border. Three variants apply via Classes on a Border:

    <Border Classes="Card Elevated"> ... </Border>   surfaceContainerLow + shadow
    <Border Classes="Card Filled">   ... </Border>   surfaceContainerHighest
    <Border Classes="Card Outlined"> ... </Border>   surface + 1px OutlineVariant

  Default radius is CornerRadiusMedium (12). `Card` alone = the Elevated look.

  RESERVED CLASS NAME: `Card` (and `.Elevated/.Filled/.Outlined` alongside it) is
  now a theme-owned Border class. A consumer's pre-existing `Border.Card` style
  will be overridden by this theme - rename any local card class to avoid the clash.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.Card">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 1 3 1 #1A000000" />
  </Style>

  <Style Selector="Border.Card.Elevated">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 1 3 1 #1A000000" />
  </Style>

  <Style Selector="Border.Card.Filled">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="Border.Card.Outlined">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

</Styles>

<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.5.3
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 AutoCompleteBox. Assembled from two patterns the bundle already
  ships: the inner field reuses the M3 Outlined TextBox look (TextBox.axaml) via
  Classes="Outlined" on PART_TextBox, and the suggestion dropdown reuses the
  ComboBox popup chrome (ComboBox.axaml) - SurfaceContainer, CornerRadiusExtraSmall,
  1px OutlineVariant border, elevation shadow, themed in-control. Suggestion rows
  are ListBoxItem containers (PART_SelectingItemsControl is a ListBox), so they pick
  up the M3 list-item state-layer / SecondaryContainer-selection treatment
  (ListBox.axaml) for free.

  Honors Avalonia's required parts: PART_TextBox, PART_SelectingItemsControl,
  PART_Popup. Default theme (no class).

  NOTE: bind the inner field's PlaceholderText to the control's PlaceholderText, NOT
  Watermark -> AutoCompleteBox.Watermark is obsolete in Avalonia 12 (AVLN5001), the
  same deprecation already handled for TextBox in 1.2.0. (1.5.1 fix.)

  NOTE: PART_SelectingItemsControl MUST be a ListBox, not a bare SelectingItemsControl.
  SelectingItemsControl is an abstract-ish primitive with NO default ControlTheme in
  FluentTheme, and Avalonia does no hierarchical ControlTheme fallback -> a bare one
  gets no template and renders an EMPTY popup (compiles clean; only the runtime visual
  pass catches it). ListBox is-a SelectingItemsControl, so it satisfies the part cast /
  SelectingItemsControlSelectionAdapter, has a working template, and generates the
  ListBoxItem rows the M3 treatment above relies on. Transparent bg + 0 border so the
  popup's SurfaceContainer reads through. (1.5.2 fix.)
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Template">
        <ControlTemplate TargetType="AutoCompleteBox">
          <Panel>
            <TextBox x:Name="PART_TextBox" Classes="Outlined"
                     PlaceholderText="{TemplateBinding PlaceholderText}" />
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True">
              <Border Background="{DynamicResource SurfaceContainer}"
                      CornerRadius="{DynamicResource CornerRadiusExtraSmall}"
                      BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1"
                      Padding="0,4" Margin="0,4,0,0"
                      MinWidth="{Binding $parent[AutoCompleteBox].Bounds.Width}"
                      BoxShadow="0 4 8 0 #33000000, 0 2 4 0 #1F000000">
                <ScrollViewer>
                  <ListBox x:Name="PART_SelectingItemsControl"
                           Background="Transparent" BorderThickness="0"
                           ItemTemplate="{TemplateBinding ItemTemplate}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>
      <!-- No root-Opacity disabled dim: the visible chrome is the inner Outlined
           PART_TextBox, which recolors itself (outline OnSurface12 / text OnSurface38)
           when the AutoCompleteBox is disabled. -->
    </ControlTheme>

  </Styles.Resources>
</Styles>

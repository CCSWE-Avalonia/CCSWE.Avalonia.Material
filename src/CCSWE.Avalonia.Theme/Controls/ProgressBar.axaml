<!--
  =============================================================================
  AUTO-GENERATED by CCSWE Design System (Avalonia) v1.7.0
  Tokens 1.1.0
  Do not edit by hand - regenerate from tokens/.
  =============================================================================

  Material 3 linear ProgressBar. Indicator = Primary, track = SurfaceVariant,
  4dp tall, fully rounded. Determinate fills by Value (ProgressBar sizes
  PART_Indicator itself). Indeterminate runs a looping sweep driven by
  ProgressBar.TemplateSettings (ContainerWidth + ContainerAnimation*Position),
  the same mechanism Avalonia's stock Fluent theme uses. Default theme (no class).

  VERIFY (consumer compile/runtime): the indeterminate animation binds to
  TemplateSettings.ContainerAnimationStartPosition / ContainerAnimationEndPosition
  / ContainerWidth - confirm those names against the pinned Avalonia 12.0.3
  ProgressBar. Determinate is the primary path and is independent of this.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}"
                  ClipToBounds="True">
            <Border x:Name="PART_Indicator"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- Disabled: neutral recolor (track OnSurface12, indicator OnSurface38), not a
           whole-element opacity dim of the Primary indicator. -->
      <Style Selector="^:disabled /template/ Border#PART_Track">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource OnSurface38}" />
      </Style>

      <!-- Indeterminate sweep (TemplateSettings-driven; see header VERIFY note). -->
      <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
      </Style>
      <Style Selector="^:indeterminate:horizontal /template/ Border#PART_Indicator">
        <Style.Animations>
          <Animation IterationCount="Infinite" Duration="0:0:2"
                     Easing="{DynamicResource MotionEasingStandard}">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.X"
                      Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.X"
                      Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>

  </Styles.Resources>
</Styles>

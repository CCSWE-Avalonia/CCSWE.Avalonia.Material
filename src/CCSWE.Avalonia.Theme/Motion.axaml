  =============================================================================

  Material 3 motion scale, resolved verbatim from tokens.upstream -> motion.
  Unlike web (Tailwind utility registration) and Compose (platform motion API),
  Avalonia consumes these directly: durations are TimeSpans, easings are
  SplineEasings built from the M3 cubic-bezier control-point arrays.

  Durations (ms)  : short1 50 .. long2 500
  Easings (x1,y1,x2,y2):
    standard             0.2, 0,   0,   1
    standardAccelerate   0.3, 0,   1,   1
    standardDecelerate   0,   0,   0,   1
    emphasized           0.2, 0,   0,   1
    emphasizedAccelerate 0.3, 0,   0.8, 0.15
    emphasizedDecelerate 0.05,0.7, 0.1, 1

  Usage:
    <Animation Duration="{StaticResource MotionDurationMedium2}"
               Easing="{StaticResource MotionEasingEmphasized}"> ... </Animation>
    <DoubleTransition Property="Opacity"
                      Duration="{DynamicResource MotionDurationShort2}"
                      Easing="{DynamicResource MotionEasingStandard}" />

  Both Animation.Duration and Transition.Duration are TimeSpan-typed in
  Avalonia, so the sys:TimeSpan resources bind directly.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:easings="using:Avalonia.Animation.Easings">

  <!-- Durations -->
  <sys:TimeSpan x:Key="MotionDurationShort1">0:0:0.05</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationShort2">0:0:0.1</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationShort3">0:0:0.15</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationShort4">0:0:0.2</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationMedium1">0:0:0.25</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationMedium2">0:0:0.3</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationMedium3">0:0:0.35</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationMedium4">0:0:0.4</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationLong1">0:0:0.45</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDurationLong2">0:0:0.5</sys:TimeSpan>

  <!-- Easings (SplineEasing X1 Y1 X2 Y2) -->
  <easings:SplineEasing x:Key="MotionEasingStandard"             X1="0.2"  Y1="0"   X2="0"   Y2="1" />
  <easings:SplineEasing x:Key="MotionEasingStandardAccelerate"   X1="0.3"  Y1="0"   X2="1"   Y2="1" />
  <easings:SplineEasing x:Key="MotionEasingStandardDecelerate"   X1="0"    Y1="0"   X2="0"   Y2="1" />
  <easings:SplineEasing x:Key="MotionEasingEmphasized"           X1="0.2"  Y1="0"   X2="0"   Y2="1" />
  <easings:SplineEasing x:Key="MotionEasingEmphasizedAccelerate" X1="0.3"  Y1="0"   X2="0.8" Y2="0.15" />
  <easings:SplineEasing x:Key="MotionEasingEmphasizedDecelerate" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />

</ResourceDictionary>

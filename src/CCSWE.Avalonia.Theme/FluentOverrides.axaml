<!--
  =============================================================================
  HAND-AUTHORED - library responsibility, NOT emitted by the design system.
  Verified against Avalonia.Themes.Fluent 12.0.3.
  =============================================================================

  FluentTheme override set. See FLUENT-AUDIT.md for the full audit and the
  three-bucket strategy. In short:
    - Bucket 1 (accent-driven Fluent controls): the SystemAccentColor remap
      brand-izes Slider, ProgressBar, selection highlights, TabItem indicators,
      etc. in one shot.  -> LIVE
    - Bucket 2 (neutral chrome): ToolTip + ScrollBar keys, verified present in
      Avalonia 12.0.3 Fluent and now LIVE. Note the ScrollBar naming asymmetry:
      the RESTING thumb is a *Color* (ScrollBarThumbBackgroundColor), while the
      hover/pressed/disabled states are *brushes* (ScrollBarThumbFill*). There is
      no ScrollBarThumbFill brush.
    - Bucket 3 (high-traffic controls): replaced by CCSWE ControlThemes. No
      override needed.

  Values are literal hex resolved from the Tokens.axaml role values (this is a
  separate ResourceDictionary merged into Application.Resources, so it carries its
  own literals rather than {StaticResource} into the theme dictionary).

  Merge AFTER Theme.axaml (in Application.Resources, via
  ResourceDictionary.MergedDictionaries) so it wins over Fluent. See
  App.sample.axaml for the exact wiring.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <!-- ================= DARK ================= -->
    <ResourceDictionary x:Key="Dark">
      <!-- Bucket 1: accent remap. Brand Primary (dark) = #659EC7. Tonal siblings
           flattened toward brand for M3's subtler accent spread. -->
      <Color x:Key="SystemAccentColor">#FF659EC7</Color>
      <Color x:Key="SystemAccentColorDark1">#FF659EC7</Color>
      <Color x:Key="SystemAccentColorDark2">#FF336699</Color>
      <Color x:Key="SystemAccentColorDark3">#FF336699</Color>
      <Color x:Key="SystemAccentColorLight1">#FFA0C8DF</Color>
      <Color x:Key="SystemAccentColorLight2">#FFA0C8DF</Color>
      <Color x:Key="SystemAccentColorLight3">#FFA0C8DF</Color>

      <!-- Bucket 2: neutral chrome (verified Avalonia 12.0.3). -->
      <SolidColorBrush x:Key="ToolTipBackground" Color="#FFE5E7EB" />              <!-- InverseSurface -->
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FF111827" />              <!-- InverseOnSurface -->
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF374151" />             <!-- OutlineVariant -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#FF374151</Color>              <!-- OutlineVariant (resting; Color, not brush) -->
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF4B5563" /> <!-- Outline -->

      <!-- Verified-but-DEFERRED (broad blast radius - base surface/text used by
           popups/flyouts/menus; needs a per-control visual pass before shipping):
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FF020617"/>  Surface
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFE5E7EB"/> OnSurface
      -->
    </ResourceDictionary>

    <!-- ================= LIGHT ================= -->
    <ResourceDictionary x:Key="Light">
      <!-- Brand Primary (light) = #336699 (secondary blue; primary alone is too
           light on a light surface, per the upstream light scheme). -->
      <Color x:Key="SystemAccentColor">#FF336699</Color>
      <Color x:Key="SystemAccentColorDark1">#FF274C73</Color>
      <Color x:Key="SystemAccentColorDark2">#FF274C73</Color>
      <Color x:Key="SystemAccentColorDark3">#FF0F2A40</Color>
      <Color x:Key="SystemAccentColorLight1">#FF659EC7</Color>
      <Color x:Key="SystemAccentColorLight2">#FF659EC7</Color>
      <Color x:Key="SystemAccentColorLight3">#FFA0C8DF</Color>

      <!-- Bucket 2: neutral chrome (verified Avalonia 12.0.3). -->
      <SolidColorBrush x:Key="ToolTipBackground" Color="#FF1F2937" />              <!-- InverseSurface -->
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FFF3F4F6" />              <!-- InverseOnSurface -->
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFD1D5DB" />             <!-- OutlineVariant -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#FFD1D5DB</Color>              <!-- OutlineVariant (resting; Color, not brush) -->
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF6B7280" /> <!-- Outline -->

      <!-- Verified-but-DEFERRED (see Dark block note):
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FFF8FAFC"/>  Surface
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FF111827"/> OnSurface
      -->
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

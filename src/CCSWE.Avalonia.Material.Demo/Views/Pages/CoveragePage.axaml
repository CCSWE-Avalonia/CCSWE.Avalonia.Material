<views:GalleryPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CCSWE.Avalonia.Material.Demo.Views"
             xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
             x:Class="CCSWE.Avalonia.Material.Demo.Views.Pages.CoveragePage"
             x:DataType="vm:MainWindowViewModel">
        <StackPanel Spacing="24" Margin="32,24,32,48">
            <TextBlock Classes="HeadlineSmall" Text="Coverage audit" />
            <Border Classes="Card Outlined">
                <StackPanel Spacing="16">
                    <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}"
                               TextWrapping="Wrap"
                               Text="The gallery now exercises the full M3 control surface across the sections above — including the hand-rolled date/time pickers and calendar on the Date &amp; time page." />
                </StackPanel>
            </Border>
        </StackPanel>
</views:GalleryPage>

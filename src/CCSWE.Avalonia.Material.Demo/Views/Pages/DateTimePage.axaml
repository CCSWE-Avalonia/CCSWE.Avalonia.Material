<views:GalleryPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CCSWE.Avalonia.Material.Demo.Views"
             xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
             x:Class="CCSWE.Avalonia.Material.Demo.Views.Pages.DateTimePage"
             x:DataType="vm:MainWindowViewModel">
        <StackPanel Spacing="24" Margin="32,24,32,48">
            <TextBlock Classes="HeadlineSmall" Text="Date &amp; time" />
            <Border Classes="Card Outlined">
                <StackPanel Spacing="16">
                    <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}"
                               TextWrapping="Wrap"
                               Text="Hand-rolled M3: the closed fields read as Outlined text fields (1px Outline → 2px Primary on focus) and track the density toggle; the spinner flyouts use a SurfaceContainerHigh surface with a SecondaryContainer selection band." />

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="PICKERS (DatePicker / TimePicker / CalendarDatePicker)" />
                    <WrapPanel ItemSpacing="12" LineSpacing="12">
                        <DatePicker VerticalAlignment="Center" />
                        <TimePicker VerticalAlignment="Center" />
                        <CalendarDatePicker VerticalAlignment="Center" Width="220" />
                    </WrapPanel>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="COMPACT (.Compact class)" />
                    <WrapPanel ItemSpacing="12" LineSpacing="12">
                        <DatePicker Classes="Compact" VerticalAlignment="Center" />
                        <TimePicker Classes="Compact" VerticalAlignment="Center" />
                    </WrapPanel>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="CALENDAR (inline)" />
                    <Calendar HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
</views:GalleryPage>

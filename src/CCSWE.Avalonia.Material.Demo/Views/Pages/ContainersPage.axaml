<views:GalleryPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CCSWE.Avalonia.Material.Demo.Views"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
             x:Class="CCSWE.Avalonia.Material.Demo.Views.Pages.ContainersPage"
             x:DataType="vm:MainWindowViewModel">
        <StackPanel Spacing="24" Margin="32,24,32,48">
            <TextBlock Classes="HeadlineSmall" Text="Containers" />
            <Border Classes="Card Outlined">
                <StackPanel Spacing="16">
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="EXPANDER" />
                    <Expander Header="Advanced options">
                        <StackPanel Spacing="8">
                            <CheckBox Content="Connect automatically on launch" />
                            <CheckBox Content="Keep screen awake while connected" IsChecked="True" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="CARD VARIANTS" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Classes="Card Elevated">
                            <TextBlock Classes="TitleSmall" Text="Elevated" />
                        </Border>
                        <Border Grid.Column="1" Classes="Card Filled">
                            <TextBlock Classes="TitleSmall" Text="Filled" />
                        </Border>
                        <Border Grid.Column="2" Classes="Card Outlined">
                            <TextBlock Classes="TitleSmall" Text="Outlined" />
                        </Border>
                    </Grid>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="INTERACTIVE CARDS (hover / press)" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <theme:Card Grid.Column="0" Classes="Elevated" Command="{Binding CardClickedCommand}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TitleSmall" Text="Elevated" />
                                <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" Text="Clickable (Command)" />
                            </StackPanel>
                        </theme:Card>
                        <theme:Card Grid.Column="1" Classes="Filled" Command="{Binding CardClickedCommand}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TitleSmall" Text="Filled" />
                                <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" Text="Clickable (Command)" />
                            </StackPanel>
                        </theme:Card>
                        <theme:Card Grid.Column="2" Classes="Outlined" IsClickable="True">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="TitleSmall" Text="Outlined" />
                                <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" Text="Clickable (IsClickable)" />
                            </StackPanel>
                        </theme:Card>
                    </Grid>
                    <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" Text="{Binding CardClicks}" />
                    <theme:Card Classes="Filled">
                        <TextBlock Classes="BodySmall" Text="Static Card (no Command, not clickable) — no hover state" />
                    </theme:Card>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="GROUPBOX" />
                    <GroupBox Header="Connection">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Label Content="Server address" />
                            <SelectableTextBlock Text="vpn.ccswe.example.com — select and copy this text" />
                        </StackPanel>
                    </GroupBox>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="DIVIDER" />
                    <StackPanel Spacing="16">
                        <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" Text="Plain rule (no header)" />
                        <theme:Divider />

                        <theme:Divider Header="Storage" />
                        <Grid ColumnDefinitions="160,*" RowSpacing="8">
                            <TextBlock Grid.Column="0" Classes="BodyMedium" Text="Internal storage" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="6 GB" />
                        </Grid>

                        <theme:Divider Header="Emulated Performance" />
                        <Grid ColumnDefinitions="160,*" RowSpacing="8">
                            <TextBlock Grid.Column="0" Classes="BodyMedium" Text="CPU cores" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="2">
                                <ComboBoxItem>1</ComboBoxItem>
                                <ComboBoxItem>2</ComboBoxItem>
                                <ComboBoxItem>4</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="GRIDSPLITTER" />
                    <Grid ColumnDefinitions="*,Auto,*" Height="80">
                        <Border Grid.Column="0" Classes="Card Filled">
                            <TextBlock Classes="BodySmall" Text="Left pane" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <GridSplitter Grid.Column="1" Width="4" Margin="6,0" />
                        <Border Grid.Column="2" Classes="Card Filled">
                            <TextBlock Classes="BodySmall" Text="Right pane" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="TABBEDPAGE (primary tabs)" />
                    <Border Height="200" CornerRadius="{DynamicResource CornerRadiusMedium}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" ClipToBounds="True">
                        <TabbedPage>
                            <ContentPage Header="Home">
                                <TextBlock Classes="BodyMedium" Text="Home page content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                            <ContentPage Header="Devices">
                                <TextBlock Classes="BodyMedium" Text="Devices page content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                            <ContentPage Header="Settings">
                                <TextBlock Classes="BodyMedium" Text="Settings page content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                        </TabbedPage>
                    </Border>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="NAVIGATIONPAGE (top app bar)" />
                    <Border Height="160" CornerRadius="{DynamicResource CornerRadiusMedium}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" ClipToBounds="True">
                        <NavigationPage>
                            <ContentPage Header="Connected devices">
                                <TextBlock Classes="BodyMedium" Text="Page content sits below the M3 top app bar." HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                        </NavigationPage>
                    </Border>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="HEADEREDCONTENTCONTROL / ITEMSCONTROL" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <HeaderedContentControl Grid.Column="0">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="TitleSmall" Text="Header" />
                            </HeaderedContentControl.Header>
                            <TextBlock Classes="BodyMedium" Margin="0,4,0,0" Text="Headered content body." />
                        </HeaderedContentControl>
                        <ItemsControl Grid.Column="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <TextBlock Classes="BodyMedium" Text="• adb devices" />
                            <TextBlock Classes="BodyMedium" Text="• adb logcat" />
                            <TextBlock Classes="BodyMedium" Text="• adb install" />
                        </ItemsControl>
                    </Grid>

                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="CAROUSELPAGE (swipe / drag between pages)" />
                    <Border Height="160" CornerRadius="{DynamicResource CornerRadiusMedium}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" ClipToBounds="True">
                        <CarouselPage>
                            <ContentPage Header="Page 1">
                                <TextBlock Classes="BodyMedium" Text="First page — drag horizontally to advance" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                            <ContentPage Header="Page 2">
                                <TextBlock Classes="BodyMedium" Text="Second page" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ContentPage>
                        </CarouselPage>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
</views:GalleryPage>

<views:GalleryPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             xmlns:views="using:CCSWE.Avalonia.Material.Demo.Views"
             xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
             x:Class="CCSWE.Avalonia.Material.Demo.Views.Pages.ButtonsPage"
             x:DataType="vm:MainWindowViewModel">
        <views:GalleryPage.Resources>
            <!-- Demo-only icons: Google Material Symbols (Outlined), inlined as path data
                 (not part of the theme's Material_Icon* set). -->
            <StreamGeometry x:Key="IconAdd">M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z</StreamGeometry>
            <StreamGeometry x:Key="IconSave">M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z</StreamGeometry>
            <StreamGeometry x:Key="IconPushPin">m16 12 2 2v2h-5v6l-1 1-1-1v-6H6v-2l2-2V5H7V3h10v2h-1Zm-7.15 2h6.3L14 12.85V5h-4v7.85ZM12 14Z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</StreamGeometry>
        </views:GalleryPage.Resources>
        <StackPanel Spacing="24" Margin="32,24,32,48">
            <TextBlock Classes="HeadlineSmall" Text="Buttons" />
            <Border Classes="Card Outlined">
                <StackPanel Spacing="16">
                    <WrapPanel ItemSpacing="12">
                        <Button Classes="Filled" Content="Filled" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="FilledTonal" Content="Tonal" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Elevated" Content="Elevated" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Outlined" Content="Outlined" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Text" Content="Text" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Icon" Content="+" VerticalAlignment="Center" Margin="0,0, 0,12" />
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="DISABLED" />
                    <WrapPanel ItemSpacing="12">
                        <Button Classes="Filled" Content="Filled" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="FilledTonal" Content="Tonal" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Elevated" Content="Elevated" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Outlined" Content="Outlined" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Text" Content="Text" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                        <Button Classes="Icon" Content="+" IsEnabled="False" VerticalAlignment="Center" Margin="0,0, 0,12" />
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="TOGGLE (off / on / disabled)" />
                    <WrapPanel>
                        <ToggleButton Content="Toggle off" Margin="0,0,12,0" />
                        <ToggleButton Content="Toggle on" IsChecked="True" Margin="0,0,12,0" />
                        <ToggleButton Content="Disabled" IsChecked="True" IsEnabled="False" Margin="0,0,12,0" />
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="MENU &amp; LINK (DropDownButton / SplitButton / HyperlinkButton)" />
                    <WrapPanel>
                        <DropDownButton Content="Options" Margin="0,0,12,12">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="All devices" />
                                    <MenuItem Header="Connected only" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <SplitButton Content="Connect" Margin="0,0,12,12" />
                        <HyperlinkButton Content="Learn more" Margin="0,0,12,12" />
                        <Button Classes="Outlined" Content="Flyout" Margin="0,0,12,12">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Width="220">
                                        <TextBlock Classes="TitleSmall" Text="Quick settings" />
                                        <TextBlock Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}"
                                                   Text="A plain Flyout rendered by the M3 FlyoutPresenter surface." TextWrapping="Wrap" />
                                        <CheckBox Content="Auto-connect" IsChecked="True" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="COMMAND BAR (button / toggle / separator + overflow)" />
                    <CommandBar>
                        <CommandBarButton Label="New">
                            <CommandBarButton.Icon>
                                <PathIcon Data="{StaticResource IconAdd}" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton Label="Save">
                            <CommandBarButton.Icon>
                                <PathIcon Data="{StaticResource IconSave}" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarSeparator />
                        <CommandBarToggleButton Label="Pin" IsChecked="True">
                            <CommandBarToggleButton.Icon>
                                <PathIcon Data="{StaticResource IconPushPin}" />
                            </CommandBarToggleButton.Icon>
                        </CommandBarToggleButton>
                        <CommandBar.SecondaryCommands>
                            <CommandBarButton Label="Settings">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{StaticResource IconSettings}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton Label="About">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{StaticResource IconInfo}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </StackPanel>
            </Border>
            <Border Classes="Card Outlined">
                <StackPanel Spacing="16">
                    <TextBlock Classes="TitleMedium" Text="Floating action button" />
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="COLOR (Primary / Secondary / Tertiary / Surface)" />
                    <WrapPanel>
                        <theme:FloatingActionButton Color="Primary" Margin="0,0,16,16" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton Color="Secondary" Margin="0,0,16,16" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton Color="Tertiary" Margin="0,0,16,16" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton Color="Surface" Margin="0,0,16,16" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="SIZE (Small / Regular / Large) &amp; DISABLED" />
                    <WrapPanel VerticalAlignment="Center">
                        <theme:FloatingActionButton Size="Small" Margin="0,0,16,16" VerticalAlignment="Center" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton Size="Regular" Margin="0,0,16,16" VerticalAlignment="Center" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton Size="Large" Margin="0,0,16,16" VerticalAlignment="Center" Command="{Binding FabClickedCommand}">
                            <PathIcon Width="36" Height="36" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                        <theme:FloatingActionButton IsEnabled="False" Margin="0,0,16,16" VerticalAlignment="Center">
                            <PathIcon Width="24" Height="24" Data="{StaticResource IconAdd}" />
                        </theme:FloatingActionButton>
                    </WrapPanel>
                    <TextBlock Classes="LabelMedium" Foreground="{DynamicResource OnSurfaceVariant}" Text="{Binding FabClicks}" />
                </StackPanel>
            </Border>
        </StackPanel>
</views:GalleryPage>

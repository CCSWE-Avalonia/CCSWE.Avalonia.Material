<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
        xmlns:conv="using:CCSWE.Avalonia.Material.Demo.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="CCSWE.Avalonia.Material.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}"
        Icon="/Assets/ccswe-logo.ico"
        Title="CCSWE.Avalonia.Material.Demo">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- Nav + chrome glyphs: Google Material Symbols (Outlined), sourced as path data.
             Material Symbols uses a 0 -960 960 960 viewBox; PathIcon wraps the Path in a
             Viewbox + Stretch=Uniform so they scale to 24dp, and Path.Fill=Foreground lets
             M3NavigationDrawerItem recolor them on :selected. These are DEMO-ONLY glyphs -
             they are not part of the theme's Material_Icon* resource set. -->
        <StreamGeometry x:Key="IconTypography">M420-160v-520H200v-120h560v120H540v520H420Z</StreamGeometry>
        <StreamGeometry x:Key="IconButtons">M4 17q-.825 0-1.412-.587Q2 15.825 2 15V9q0-.825.588-1.413Q3.175 7 4 7h16q.825 0 1.413.587Q22 8.175 22 9v6q0 .825-.587 1.413Q20.825 17 20 17h-1v-2h1V9H4v6h6v2Zm10.5 2-1.1-2.4-2.4-1.1 2.4-1.1 1.1-2.4 1.1 2.4 2.4 1.1-2.4 1.1Zm2.5-5-.625-1.375L15 12l1.375-.625L17 10l.625 1.375L19 12l-1.375.625Z</StreamGeometry>
        <StreamGeometry x:Key="IconInputs">M160-160q-33 0-56.5-23.5T80-240v-120h80v120h640v-480H160v120H80v-120q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm300-140-56-58 83-82H80v-80h407l-83-82 56-58 180 180-180 180Z</StreamGeometry>
        <StreamGeometry x:Key="IconSelection">m424-296 282-282-56-56-226 226-114-114-56 56 170 170Zm56 216q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z</StreamGeometry>
        <StreamGeometry x:Key="IconCollections">M280-600v-80h560v80H280Zm0 160v-80h560v80H280Zm0 160v-80h560v80H280ZM160-600q-17 0-28.5-11.5T120-640q0-17 11.5-28.5T160-680q17 0 28.5 11.5T200-640q0 17-11.5 28.5T160-600Zm0 160q-17 0-28.5-11.5T120-480q0-17 11.5-28.5T160-520q17 0 28.5 11.5T200-480q0 17-11.5 28.5T160-440Zm0 160q-17 0-28.5-11.5T120-320q0-17 11.5-28.5T160-360q17 0 28.5 11.5T200-320q0 17-11.5 28.5T160-280Z</StreamGeometry>
        <StreamGeometry x:Key="IconFeedback">M480-360q17 0 28.5-11.5T520-400q0-17-11.5-28.5T480-440q-17 0-28.5 11.5T440-400q0 17 11.5 28.5T480-360Zm-40-160h80v-240h-80v240ZM80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z</StreamGeometry>
        <StreamGeometry x:Key="IconTabs">M160-240h640v-320H520v-160H160v480Zm0 80q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80v-480 480Z</StreamGeometry>
        <StreamGeometry x:Key="IconContainers">M666-440 440-666l226-226 226 226-226 226Zm-546-80v-320h320v320H120Zm400 400v-320h320v320H520Zm-400 0v-320h320v320H120Zm80-480h160v-160H200v160Zm467 48 113-113-113-113-113 113 113 113Zm-67 352h160v-160H600v160Zm-400 0h160v-160H200v160Zm160-400Zm194-65ZM360-360Zm240 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconIcons">m260-520 220-360 220 360H260ZM700-80q-75 0-127.5-52.5T520-260q0-75 52.5-127.5T700-440q75 0 127.5 52.5T880-260q0 75-52.5 127.5T700-80Zm-580-20v-320h320v320H120Zm580-60q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Zm-500-20h160v-160H200v160Zm202-420h156l-78-126-78 126Zm78 0ZM360-340Zm340 80Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm70-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z</StreamGeometry>
        <StreamGeometry x:Key="IconCaretLeft">M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z</StreamGeometry>
        <StreamGeometry x:Key="IconMoon">M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z</StreamGeometry>
        <StreamGeometry x:Key="IconRows">M200-520q-33 0-56.5-23.5T120-600v-160q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v160q0 33-23.5 56.5T760-520H200Zm0-80h560v-160H200v160Zm0 480q-33 0-56.5-23.5T120-200v-160q0-33 23.5-56.5T200-440h560q33 0 56.5 23.5T840-360v160q0 33-23.5 56.5T760-120H200Zm0-80h560v-160H200v160Zm0-560v160-160Zm0 400v160-160Z</StreamGeometry>
        <StreamGeometry x:Key="IconDateTime">M580-240q-42 0-71-29t-29-71q0-42 29-71t71-29q42 0 71 29t29 71q0 42-29 71t-71 29ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z</StreamGeometry>
        <conv:NavIndexToPageConverter x:Key="NavIndexToPage" />
    </Window.Resources>

    <!-- The demo shell IS a DrawerPage: a locked (always-open, docked) navigation
         drawer drives the gallery. DrawerHeader = brand, Drawer = destinations,
         DrawerFooter = theme toggle, Content = a TransitioningContentControl (PageHost)
         that shows one page per nav index (NavIndexToPageConverter). XAML-only. -->
    <Panel>
    <DrawerPage x:Name="Shell" DrawerBehavior="Locked" IsOpen="True">

        <!-- Brand header -->
        <DrawerPage.DrawerHeader>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,20,24,12">
                <!-- CCSWE brand mark (ccswe-logo.svg converted to Avalonia paths: two
                     gradient "C" shapes over a dark underlay; PathIcon can't do the
                     gradient/multi-path, so a Viewbox of Paths is used). -->
                <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                    <Canvas Width="100" Height="100">
                        <Canvas.Resources>
                            <LinearGradientBrush x:Key="LogoGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#336699" />
                                <GradientStop Offset="0.5" Color="#659EC7" />
                                <GradientStop Offset="1" Color="#A0C8DF" />
                            </LinearGradientBrush>
                        </Canvas.Resources>
                        <Path Data="M 47.5,15 A 35,35 0 1,0 47.5,85 L 47.5,67 A 17,17 0 1,1 47.5,33 Z" Fill="#0F172A" />
                        <Path Fill="#0F172A">
                            <Path.Data>
                                <PathGeometry Figures="M 52.5,15 A 35,35 0 1,0 52.5,85 L 52.5,67 A 17,17 0 1,1 52.5,33 Z">
                                    <PathGeometry.Transform>
                                        <RotateTransform Angle="180" CenterX="52.5" CenterY="50" />
                                    </PathGeometry.Transform>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Path Data="M 47.5,15 A 35,35 0 1,0 47.5,85 L 47.5,67 A 17,17 0 1,1 47.5,33 Z" Fill="{StaticResource LogoGradient}" />
                        <Path Fill="{StaticResource LogoGradient}" Opacity="0.6">
                            <Path.Data>
                                <PathGeometry Figures="M 52.5,15 A 35,35 0 1,0 52.5,85 L 52.5,67 A 17,17 0 1,1 52.5,33 Z">
                                    <PathGeometry.Transform>
                                        <RotateTransform Angle="180" CenterX="52.5" CenterY="50" />
                                    </PathGeometry.Transform>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>
                </Viewbox>
                <TextBlock Classes="TitleLarge" Text="MaterialTheme" VerticalAlignment="Center"
                           IsVisible="{Binding !IsRail}" />
            </StackPanel>
        </DrawerPage.DrawerHeader>

        <!-- Navigation destinations. Two lists share one selection: the labeled drawer
             (expanded) and the icon rail (collapsed). The footer chevron toggles IsRail,
             swapping visibility + DrawerLength 360<->80 — DrawerPage's compact mode. -->
        <DrawerPage.Drawer>
            <Panel>
            <ListBox x:Name="NavList" Classes="NavigationDrawer" SelectedIndex="0"
                     IsVisible="{Binding !IsRail}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconTypography}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Typography" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconButtons}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Buttons" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconInputs}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Inputs" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconDateTime}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Date / Time" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconSelection}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Selection" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconCollections}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Collections" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconFeedback}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Feedback" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconTabs}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Tabs" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconContainers}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Containers" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconIcons}" Width="24" Height="24" />
                        <TextBlock Classes="LabelLarge" Text="Icons" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <ListBox x:Name="RailList" Classes="NavigationRail" VerticalAlignment="Top"
                     IsVisible="{Binding IsRail}"
                     SelectedIndex="{Binding #NavList.SelectedIndex, Mode=TwoWay}">
                <ListBoxItem ToolTip.Tip="Typography"><PathIcon Data="{StaticResource IconTypography}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Buttons"><PathIcon Data="{StaticResource IconButtons}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Inputs"><PathIcon Data="{StaticResource IconInputs}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Date / Time"><PathIcon Data="{StaticResource IconDateTime}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Selection"><PathIcon Data="{StaticResource IconSelection}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Collections"><PathIcon Data="{StaticResource IconCollections}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Feedback"><PathIcon Data="{StaticResource IconFeedback}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Tabs"><PathIcon Data="{StaticResource IconTabs}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Containers"><PathIcon Data="{StaticResource IconContainers}" Width="24" Height="24" /></ListBoxItem>
                <ListBoxItem ToolTip.Tip="Icons"><PathIcon Data="{StaticResource IconIcons}" Width="24" Height="24" /></ListBoxItem>
            </ListBox>
            </Panel>
        </DrawerPage.Drawer>

        <!-- Pinned footer: one row — sun/moon theme toggle (left, hidden in the 80dp rail)
             and the collapse/expand chevron (right; centers when collapsed to the rail).
             Both are M3 icon buttons (40dp container / 24dp glyph). -->
        <DrawerPage.DrawerFooter>
            <Border Padding="12,12" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="0,1,0,0">
                <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                IsVisible="{Binding !IsRail}">
                        <Button x:Name="ThemeToggleBtn" Classes="Icon"
                                Click="OnThemeToggleClick" ToolTip.Tip="Toggle light / dark theme">
                            <PathIcon x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Width="24" Height="24" />
                        </Button>
                        <Button x:Name="DensityToggleBtn" Classes="Icon"
                                Click="OnDensityToggleClick" ToolTip.Tip="Toggle normal / compact density">
                            <PathIcon Data="{StaticResource IconRows}" Width="24" Height="24" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="RailToggleBtn" Classes="Icon" HorizontalAlignment="Right"
                            Click="OnToggleRail" ToolTip.Tip="Collapse / expand navigation">
                        <PathIcon x:Name="CollapseChevron" Data="{StaticResource IconCaretLeft}"
                                  Width="24" Height="24" RenderTransformOrigin="50%,50%" />
                    </Button>
                </Panel>
            </Border>
        </DrawerPage.DrawerFooter>

        <!-- Main content: one page per destination, swapped by nav selection. The
             pane↔content trailing-edge divider is now baked into the DrawerPage template
             (PART_PaneDivider), so no consumer-side Border is needed.
             DrawerPage's main-content slot does NOT inherit the window DataContext (its
             DrawerHeader/Footer slots do). So set it explicitly here; PageHost and every
             hosted page then bind against the VM. -->
        <Border DataContext="{Binding $parent[Window].DataContext}">
            <TransitioningContentControl x:Name="PageHost"
                                         Content="{Binding #NavList.SelectedIndex, Converter={StaticResource NavIndexToPage}}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.15" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Border>

    </DrawerPage>

        <!-- Record-mode countdown: shown during the start delay so an external recorder can be
             armed, then hidden when one second remains so it isn't captured. -->
        <Border x:Name="CountdownOverlay"
                IsVisible="False"
                Background="{DynamicResource Scrim32}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock x:Name="CountdownText"
                       Classes="DisplayLarge"
                       Foreground="{DynamicResource OnSurface}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

    </Panel>

</Window>

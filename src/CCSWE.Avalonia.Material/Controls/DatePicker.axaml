<!--
  Material 3 DatePicker. The closed field reads as an M3 Outlined text field (transparent
  fill, 1px Outline -> 2px Primary on focus, CornerRadiusExtraSmall, TextFieldMinHeight so it
  tracks the density toggle) carrying day/month/year segments. The flyout is an M3
  SurfaceContainerHigh surface (rounded, elevated) hosting the day/month/year spinner.

  This is the spinner-style date entry; CalendarDatePicker is the calendar-based variant.
  The Avalonia DatePicker/DatePickerPresenter template-part contract (PART_FlyoutButton,
  PART_Popup, PART_PickerPresenter, PART_*Selector/Host/Up/DownButton, HighlightRect,
  PART_*Spacer, PART_Accept/DismissButton) is preserved verbatim. Shared spinner sub-themes
  live in Controls/DateTimePickerShared.axaml. Structure derived from Avalonia 12 Simple.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="DatePickerFlyoutPresenterHighlightHeight">40</x:Double>
  <x:Double x:Key="DatePickerFlyoutPresenterItemHeight">40</x:Double>
  <x:Double x:Key="DatePickerFlyoutPresenterAcceptDismissHostGridHeight">41</x:Double>
  <x:Double x:Key="DatePickerThemeMinWidth">296</x:Double>
  <x:Double x:Key="DatePickerThemeMaxWidth">456</x:Double>
  <Thickness x:Key="DatePickerFlyoutPresenterItemPadding">0,3,0,6</Thickness>
  <Thickness x:Key="DatePickerFlyoutPresenterMonthPadding">9,3,0,6</Thickness>
  <Thickness x:Key="DatePickerHostPadding">0,3,0,6</Thickness>
  <Thickness x:Key="DatePickerHostMonthPadding">9,3,0,6</Thickness>
  <x:Double x:Key="DatePickerSpacerThemeWidth">1</x:Double>

  <!-- The field trigger. Just hosts the segment grid; the M3 outline/fill/focus treatment
       lives on the DatePicker ControlTheme below (it flows in via TemplateBindings). -->
  <ControlTheme x:Key="M3DatePickerFlyoutButton" TargetType="Button">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePicker}"
                TargetType="DatePicker">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusExtraSmall}" />
    <Setter Property="MinHeight" Value="{DynamicResource TextFieldMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid Name="LayoutRoot"
                Margin="{TemplateBinding Padding}">

            <Button Name="PART_FlyoutButton"
                    MinWidth="{DynamicResource DatePickerThemeMinWidth}"
                    MaxWidth="{DynamicResource DatePickerThemeMaxWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    TemplatedControl.IsTemplateFocusTarget="True"
                    Theme="{StaticResource M3DatePickerFlyoutButton}">
              <Grid Name="PART_ButtonContentGrid"
                    ColumnDefinitions="78*,Auto,132*,Auto,78*">
                <TextBlock Name="PART_DayTextBlock"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           HorizontalAlignment="Center"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Text="{DynamicResource StringDatePickerDayText}" />
                <TextBlock Name="PART_MonthTextBlock"
                           Padding="{DynamicResource DatePickerHostMonthPadding}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Text="{DynamicResource StringDatePickerMonthText}"
                           TextAlignment="Left" />
                <TextBlock Name="PART_YearTextBlock"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           HorizontalAlignment="Center"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Text="{DynamicResource StringDatePickerYearText}" />
                <Rectangle x:Name="PART_FirstSpacer"
                           Grid.Column="1"
                           Width="1"
                           HorizontalAlignment="Center"
                           Fill="{DynamicResource OutlineVariant}" />
                <Rectangle x:Name="PART_SecondSpacer"
                           Grid.Column="3"
                           Width="1"
                           HorizontalAlignment="Center"
                           Fill="{DynamicResource OutlineVariant}" />
              </Grid>
            </Button>

            <Popup Name="PART_Popup"
                   IsLightDismissEnabled="True"
                   Placement="Bottom"
                   PlacementTarget="{TemplateBinding}"
                   WindowManagerAddShadowHint="False">
              <DatePickerPresenter Name="PART_PickerPresenter" />
            </Popup>

          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- M3 field states (outline thickens to Primary on focus; OnSurface on hover; Error). -->
    <Style Selector="^:pointerover /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface}" />
    </Style>
    <Style Selector="^:focus-within /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    </Style>

    <!-- Disabled: neutral M3 recolor (outline OnSurface12, content OnSurface38), not a dim. -->
    <Style Selector="^:disabled /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface12}" />
    </Style>
    <Style Selector="^:disabled /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
    </Style>

    <!-- Watermark colour when no date is selected. -->
    <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <!-- Opt-in compact density for the field (independent of the theme-level DensityStyle). -->
    <Style Selector="^.Compact">
      <Setter Property="MinHeight" Value="{DynamicResource TextFieldMinHeightCompact}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePickerPresenter}"
                TargetType="DatePickerPresenter">
    <Setter Property="Width" Value="296" />
    <Setter Property="MinWidth" Value="296" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DateTimeFlyoutBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Background"
                MaxHeight="398"
                Padding="{DynamicResource DateTimeFlyoutBorderPadding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="False"
                BoxShadow="0 4 8 0 #33000000, 0 2 4 0 #1F000000">
          <Grid Name="ContentRoot"
                RowDefinitions="*,Auto">
            <Grid Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource M3DateTimePickerItem}" />
                </Style>
              </Grid.Styles>
              <!--  Column Definitions set in code, ignore here  -->
              <Panel Name="PART_MonthHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_MonthSelector"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       PanelType="Month"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton Name="PART_MonthUpButton"
                              Theme="{StaticResource M3DateTimePickerUpButton}" />
                <RepeatButton Name="PART_MonthDownButton"
                              Theme="{StaticResource M3DateTimePickerDownButton}" />
              </Panel>
              <Panel Name="PART_DayHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_DaySelector"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       PanelType="Day"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton Name="PART_DayUpButton"
                              Theme="{StaticResource M3DateTimePickerUpButton}" />
                <RepeatButton Name="PART_DayDownButton"
                              Theme="{StaticResource M3DateTimePickerDownButton}" />
              </Panel>
              <Panel Name="PART_YearHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_YearSelector"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       PanelType="Year"
                                       ShouldLoop="False" />
                </ScrollViewer>
                <RepeatButton Name="PART_YearUpButton"
                              Theme="{StaticResource M3DateTimePickerUpButton}" />
                <RepeatButton Name="PART_YearDownButton"
                              Theme="{StaticResource M3DateTimePickerDownButton}" />
              </Panel>
              <Rectangle Name="HighlightRect"
                         Grid.Column="0"
                         Grid.ColumnSpan="5"
                         Height="{DynamicResource DatePickerFlyoutPresenterHighlightHeight}"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         ZIndex="-1">
                <Rectangle.Fill>
                  <SolidColorBrush Color="{DynamicResource SecondaryContainerColor}" />
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle Name="PART_FirstSpacer"
                         Grid.Column="1"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource OutlineVariant}" />
              <Rectangle Name="PART_SecondSpacer"
                         Grid.Column="3"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource OutlineVariant}" />
            </Grid>

            <Grid Name="AcceptDismissGrid"
                  Grid.Row="1"
                  ColumnDefinitions="*,*">
              <Rectangle Grid.ColumnSpan="2"
                         Height="{DynamicResource DatePickerSpacerThemeWidth}"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource OutlineVariant}" />
              <Button Name="PART_AcceptButton"
                      Grid.Column="0"
                      Height="{DynamicResource DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Theme="{StaticResource M3DateTimePickerButton}">
                <Path Data="M0.5,8.5 5,13.5 15.5,3"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeLineCap="Round"
                      StrokeThickness="0.75" />
              </Button>
              <Button Name="PART_DismissButton"
                      Grid.Column="1"
                      Height="{DynamicResource DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Theme="{StaticResource M3DateTimePickerButton}">
                <Path Data="M2,2 14,14 M2,14 14 2"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeLineCap="Round"
                      StrokeThickness="0.75" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Panel">
      <Style Selector="^:pointerover RepeatButton">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>

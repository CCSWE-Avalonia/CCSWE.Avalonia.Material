<!--
  Material 3 primary tabs - the content-less variant. A TabStrip is the bare
  selection strip (no paired content host), so this is the TabItem treatment from
  TabControl.axaml cloned onto TabStripItem 1:1: a LabelLarge that reads
  OnSurfaceVariant unselected / Primary selected, a 3dp Primary indicator under
  the selected item, and an OnSurface state layer at hover .08 / pressed .10. The
  TabStrip itself is a transparent horizontal strip with a 1px OutlineVariant
  bottom divider, matching the TabControl header. Default themes (no class).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabStrip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource OutlineVariant}"
                  BorderThickness="0,0,0,1">
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="0" />
        </ItemsPanelTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem">
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.1" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="{DynamicResource ItemMinHeight}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabStripItem">
          <Panel>
            <Border x:Name="StateLayer" Background="{DynamicResource OnSurface}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ContentPresenter Grid.Row="0" x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border Grid.Row="1" x:Name="Indicator" Height="3" Background="{DynamicResource Primary}"
                      CornerRadius="3,3,0,0" Opacity="0" />
            </Grid>
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      </Style>
      <Style Selector="^:selected /template/ Border#Indicator">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <!-- Disabled: recolor the label to OnSurface38 (not a whole-element opacity dim). -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!-- Opt-in compact density for tabs (independent of the theme-level DensityStyle). -->
  <Style Selector="TabStrip.Compact TabStripItem">
    <Setter Property="MinHeight" Value="{DynamicResource ItemMinHeightCompact}" />
  </Style>
</Styles>

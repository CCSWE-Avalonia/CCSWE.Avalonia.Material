<!--
  =============================================================================
  HAND-AUTHORED M3 control theme (library-owned). Replaces the interim
  Base/ScrollBar.axaml fork.
  =============================================================================

  M3-style thin scrollbar: a rounded "pill" thumb on a transparent track, no
  arrow buttons (Material has none). Thumb color = OutlineVariant at rest ->
  Outline on hover -> OnSurfaceVariant when dragged, with a short colour
  transition. References M3 tokens directly.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <!-- The rounded pill thumb. -->
    <ControlTheme x:Key="M3ScrollBarThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource OutlineVariant}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource CornerRadiusFull}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationShort2}" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Outline}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource OnSurfaceVariant}" />
      </Style>
    </ControlTheme>

    <!-- Invisible-but-clickable page-scroll button (click the track to page). -->
    <ControlTheme x:Key="M3ScrollBarPageButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Arrow" />

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="2">
            <Track Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource M3ScrollBarPageButton}" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource M3ScrollBarPageButton}" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource M3ScrollBarThumb}" Width="8" MinHeight="40" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="2">
            <Track Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                   Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource M3ScrollBarPageButton}" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource M3ScrollBarPageButton}" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource M3ScrollBarThumb}" Height="8" MinWidth="40" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    </ControlTheme>

  </Styles.Resources>

</Styles>

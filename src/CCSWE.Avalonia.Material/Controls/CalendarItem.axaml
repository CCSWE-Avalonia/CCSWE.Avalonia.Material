<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Margin="0,2,0,2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.Styles>
                  <Style Selector="Button.CalendarHeader">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
                  </Style>
                  <Style Selector="Button.CalendarHeader:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>

                  <Style Selector="Button.CalendarNavigation">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Width" Value="32" />
                  </Style>
                  <Style Selector="Button.CalendarNavigation > Path">
                    <Setter Property="Fill" Value="{DynamicResource OnSurfaceVariant}" />
                  </Style>
                  <Style Selector="Button.CalendarNavigation:pointerover > Path">
                    <Setter Property="Fill" Value="{DynamicResource OnSurface}" />
                  </Style>

                  <Style Selector="Button#PART_HeaderButton">
                    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
                    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabelLarge}" />
                    <Setter Property="FontWeight" Value="Medium" />
                  </Style>
                  <Style Selector="Button#PART_HeaderButton:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                  </Style>
                </Grid.Styles>

                <Button Name="PART_PreviousButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Classes="CalendarHeader CalendarNavigation"
                        IsVisible="False">
                  <Path Width="6"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M288.75,232.25 L288.75,240.625 L283,236.625 z"
                        Stretch="Fill" />
                </Button>

                <Button Name="PART_HeaderButton"
                        Grid.Column="1"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="CalendarHeader" />

                <Button Name="PART_NextButton"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Classes="CalendarHeader CalendarNavigation"
                        IsVisible="False">
                  <Path Width="6"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M282.875,231.875 L282.875,240.375 L288.625,236 z"
                        Stretch="Fill" />
                </Button>

                <Grid Name="PART_MonthView"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Margin="0,4,0,0"
                      IsVisible="False">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                </Grid>

                <Grid Name="PART_YearView"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Margin="0,4,0,0"
                      IsVisible="False">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                </Grid>
              </Grid>
            </Border>

            <Rectangle Name="DisabledVisual"
                       Margin="0,2,0,2"
                       Fill="{DynamicResource Surface}"
                       IsVisible="False"
                       Opacity="0.6"
                       Stretch="Fill" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Setter Property="DayTitleTemplate">
        <Template x:DataType="x:String">
          <TextBlock Margin="0,4,0,8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="{DynamicResource BodyFontFamily}"
                     FontSize="{DynamicResource FontSizeLabelMedium}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     Text="{Binding}" />
        </Template>
      </Setter>

      <Style Selector="^:calendardisabled /template/ Rectangle#DisabledVisual">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

</Styles>

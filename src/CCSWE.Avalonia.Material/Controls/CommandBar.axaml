<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- CommandBarButton -->
    <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Width" Value="68" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Border x:Name="PART_StateLayer"
                      Background="{DynamicResource OnSurfaceVariant}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{DynamicResource MotionDurationShort2}"
                                      Easing="{DynamicResource MotionEasingStandard}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <StackPanel x:Name="PART_LayoutRoot"
                          Spacing="4"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" />
                <TextBlock x:Name="PART_Label"
                           Text="{TemplateBinding Label}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{DynamicResource FontSizeLabelSmall}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.12" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>

      <!-- Compact: hide label, reduce width -->
      <Style Selector="^[IsCompact=True]">
        <Setter Property="Width" Value="40" />
      </Style>
      <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
        <Setter Property="IsVisible" Value="False" />
      </Style>

      <!-- LabelPosition=Right: horizontal layout, auto-width -->
      <Style Selector="^[LabelPosition=Right]">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="40" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
        <Setter Property="Orientation" Value="Horizontal" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- IsInOverflow: full-width horizontal layout -->
      <Style Selector="^[IsInOverflow=True]">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="0" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="4,0,10,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ControlTheme>

    <!-- CommandBarToggleButton -->
    <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Width" Value="68" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Border x:Name="PART_StateLayer"
                      Background="{DynamicResource OnSurfaceVariant}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{DynamicResource MotionDurationShort2}"
                                      Easing="{DynamicResource MotionEasingStandard}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <StackPanel x:Name="PART_LayoutRoot"
                          Spacing="4"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" />
                <TextBlock x:Name="PART_Label"
                           Text="{TemplateBinding Label}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{DynamicResource FontSizeLabelSmall}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.12" />
      </Style>

      <!-- Checked: M3 selected = SecondaryContainer fill + OnSecondaryContainer content -->
      <Style Selector="^:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_StateLayer">
        <Setter Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>
      <Style Selector="^:checked /template/ TextBlock#PART_Label">
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>

      <!-- Compact: hide label, reduce width -->
      <Style Selector="^[IsCompact=True]">
        <Setter Property="Width" Value="40" />
      </Style>
      <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
        <Setter Property="IsVisible" Value="False" />
      </Style>

      <!-- LabelPosition=Right: horizontal layout, auto-width -->
      <Style Selector="^[LabelPosition=Right]">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="40" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
        <Setter Property="Orientation" Value="Horizontal" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- IsInOverflow: full-width horizontal layout -->
      <Style Selector="^[IsInOverflow=True]">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="0" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="4,0,10,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ControlTheme>

    <!-- CommandBarSeparator -->
    <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
      <Setter Property="Width" Value="1" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource OutlineVariant}"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  MinHeight="{TemplateBinding MinHeight}" />
        </ControlTemplate>
      </Setter>

      <!-- IsInOverflow: horizontal separator -->
      <Style Selector="^[IsInOverflow=True]">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="4,4" />
      </Style>
    </ControlTheme>

    <!-- CommandBar -->
    <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="ItemWidthBottom" Value="70" />
      <Setter Property="ItemWidthRight" Value="102" />
      <Setter Property="ItemWidthCollapsed" Value="42" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  MinHeight="{TemplateBinding MinHeight}">
            <Panel>
              <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <!-- Overflow button (docked right) -->
                <Button x:Name="PART_OverflowButton"
                        DockPanel.Dock="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        MinWidth="40"
                        VerticalAlignment="Stretch"
                        IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                  <PathIcon Width="16" Height="16"
                            Foreground="{TemplateBinding Foreground}"
                            Data="M6,10A2,2 0 0,0 4,12A2,2 0 0,0 6,14A2,2 0 0,0 8,12A2,2 0 0,0 6,10M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M18,10A2,2 0 0,0 16,12A2,2 0 0,0 18,14A2,2 0 0,0 20,12A2,2 0 0,0 18,10Z" />
                </Button>

                <!-- Custom content area (docked left) -->
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Center" />

                <!-- Primary commands (fills remaining space, right-aligned) -->
                <ItemsControl x:Name="PART_PrimaryCommands"
                              ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </DockPanel>

              <!-- Overflow popup (M3 menu surface) -->
              <Popup x:Name="PART_OverflowPopup"
                     IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #PART_OverflowButton}"
                     Placement="Bottom"
                     IsLightDismissEnabled="True"
                     WindowManagerAddShadowHint="True">
                <Border Background="{DynamicResource SurfaceContainer}"
                        BorderBrush="{DynamicResource OutlineVariant}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusExtraSmall}"
                        Padding="4"
                        MinWidth="160">
                  <ItemsControl x:Name="PART_OverflowPresenter"
                                ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </Popup>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

</Styles>

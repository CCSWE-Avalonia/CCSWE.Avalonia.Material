<!--
  Material 3 toggle button. The M3 "toggle" is the Outlined -> Filled Tonal flip,
  so this reuses the button language from Button.axaml as a default ControlTheme
  on every ToggleButton:

    - unselected - transparent pill, 1px Outline, OnSurfaceVariant label + state
                   layer (hover .08 / pressed .10).
    - :checked   - SecondaryContainer fill, OnSecondaryContainer label, border
                   recolored to Transparent (thickness stays 1px so the pill does
                   NOT reflow on toggle - container-border rule, see CONVENTIONS);
                   state layer = OnSecondaryContainer.
    - :disabled  - container OnSurface12 (checked) / border OnSurface12 (unselected),
                   label recolored to the neutral OnSurface38 (NOT an opacity dim of
                   the colored foreground - the Button-family disabled rule).

  Shape = full pill (CornerRadiusFull), MinHeight 40, like the button family.
  ToggleButtons used as template parts elsewhere (e.g. the TreeViewItem chevron)
  opt out by supplying their own local template.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}" />
      <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Border x:Name="PART_StateLayer"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Background="{DynamicResource OnSurfaceVariant}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{DynamicResource MotionDurationShort2}"
                                      Easing="{DynamicResource MotionEasingStandard}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>

      <!-- Checked = Filled Tonal. Keep BorderThickness=1 and hide the border via
           Transparent brush so the SecondaryContainer fill reads through; changing
           thickness on a *container* border (content inside it) would reflow the
           pill 1px on every toggle. -->
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_StateLayer">
        <Setter Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
      </Style>

      <!-- Disabled: neutral OnSurface38 label (recolor, not opacity dim) -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Container">
        <Setter Property="BorderBrush" Value="{DynamicResource OnSurface12}" />
      </Style>
      <Style Selector="^:checked:disabled /template/ Border#PART_Container">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!-- Opt-in compact density (independent of the theme-level DensityStyle property). -->
  <Style Selector="ToggleButton.Compact">
    <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeightCompact}" />
  </Style>
</Styles>

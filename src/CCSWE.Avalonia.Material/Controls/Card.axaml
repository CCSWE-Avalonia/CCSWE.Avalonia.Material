<!--
  Material 3 cards. Two ways to make one:

  1. The `Card` control (interactive-capable) - shows hover/pressed state layers and
     raises Click / runs Command when clickable (Command set, or IsClickable="True"):

       <theme:Card Classes="Elevated" Command="{Binding Open}"> ... </theme:Card>

  2. The `Border.Card` class convention (cheap static surface, no state layer) - for
     section wrappers and other non-interactive containers:

       <Border Classes="Card Outlined"> ... </Border>

  Variants for both: Elevated (surfaceContainerLow + shadow), Filled (surfaceContainerHighest),
  Outlined (surface + 1px OutlineVariant). Default radius CornerRadiusMedium (12); plain = Elevated.

  RESERVED CLASS NAME: `Card` (+ `.Elevated/.Filled/.Outlined`) is a theme-owned Border class -
  rename any local `Border.Card` style to avoid the clash.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:CCSWE.Avalonia.Material">

  <Styles.Resources>

    <!-- Base - template + shared metrics. State layer = neutral OnSurface over the variant's
         surface, painted at hover 0.08 / pressed 0.10, gated on :clickable so static cards stay inert. -->
    <ControlTheme x:Key="M3CardBase" TargetType="theme:Card">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
      <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate TargetType="theme:Card">
          <Border x:Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Border x:Name="PART_StateLayer"
                      Background="{DynamicResource OnSurface}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{DynamicResource MotionDurationShort2}"
                                      Easing="{DynamicResource MotionEasingStandard}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:clickable">
        <Setter Property="Cursor" Value="Hand" />
      </Style>
      <Style Selector="^:clickable:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:clickable:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.38" />
      </Style>
    </ControlTheme>

    <!-- Elevated - surfaceContainerLow + level-1 shadow; raises to level-2 on hover (M3). The shadow
         renders correctly because the control sets ClipToBounds=False (otherwise the template root's
         BoxShadow is clipped to bounds). In Dark the shadow is faint, so the shared state layer
         carries the hover feedback there. Snaps; BoxShadowsTransition is unreliable. -->
    <ControlTheme x:Key="M3ElevatedCard" TargetType="theme:Card" BasedOn="{StaticResource M3CardBase}">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
      <Style Selector="^ /template/ Border#PART_Container">
        <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 1 3 1 #1A000000" />
      </Style>
      <Style Selector="^:clickable:pointerover /template/ Border#PART_Container">
        <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 2 6 2 #1A000000" />
      </Style>
    </ControlTheme>

    <!-- Filled - surfaceContainerHighest, no shadow. -->
    <ControlTheme x:Key="M3FilledCard" TargetType="theme:Card" BasedOn="{StaticResource M3CardBase}">
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
    </ControlTheme>

    <!-- Outlined - surface + 1px OutlineVariant, no shadow. -->
    <ControlTheme x:Key="M3OutlinedCard" TargetType="theme:Card" BasedOn="{StaticResource M3CardBase}">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
      <Setter Property="BorderThickness" Value="1" />
    </ControlTheme>

    <!-- Default {x:Type Card} (no class) = Elevated, matching the Border.Card default. -->
    <ControlTheme x:Key="{x:Type theme:Card}" TargetType="theme:Card" BasedOn="{StaticResource M3ElevatedCard}" />

  </Styles.Resources>

  <!-- Card control - convenience variant class selectors -->
  <Style Selector="theme|Card.Elevated">
    <Setter Property="Theme" Value="{StaticResource M3ElevatedCard}" />
  </Style>
  <Style Selector="theme|Card.Filled">
    <Setter Property="Theme" Value="{StaticResource M3FilledCard}" />
  </Style>
  <Style Selector="theme|Card.Outlined">
    <Setter Property="Theme" Value="{StaticResource M3OutlinedCard}" />
  </Style>
  <!-- Opt-in compact density (padding only; composes with the variant classes). -->
  <Style Selector="theme|Card.Compact">
    <Setter Property="Padding" Value="{DynamicResource CardPaddingCompact}" />
  </Style>

  <!-- Border.Card class convention - static surfaces, no state layer -->
  <Style Selector="Border.Card">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 1 3 1 #1A000000" />
  </Style>
  <Style Selector="Border.Card.Compact">
    <Setter Property="Padding" Value="{DynamicResource CardPaddingCompact}" />
  </Style>

  <Style Selector="Border.Card.Elevated">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLow}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000, 0 1 3 1 #1A000000" />
  </Style>

  <Style Selector="Border.Card.Filled">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="Border.Card.Outlined">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

</Styles>

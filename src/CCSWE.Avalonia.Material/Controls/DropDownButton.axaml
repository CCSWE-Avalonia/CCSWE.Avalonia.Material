<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}" />
      <Setter Property="Padding" Value="20,0,16,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeLabelLarge}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="RootBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Panel>
              <Border x:Name="PART_StateLayer"
                      Background="{DynamicResource OnSecondaryContainer}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.Column="0"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource OnSecondaryContainer}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <PathIcon x:Name="DropDownGlyph"
                          Grid.Column="1"
                          Width="18" Height="18"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Foreground="{DynamicResource OnSecondaryContainer}"
                          Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />
              </Grid>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <Style Selector="^:disabled /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource OnSurface12}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
      <Style Selector="^:disabled /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- M3 month/year cell (Calendar year & decade views): pill-shaped, transparent default,
         selected = Primary fill + OnPrimary, hover/pressed = OnSurface state layer. -->
    <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
      <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Border Name="SelectedBackground"
                    CornerRadius="{DynamicResource CornerRadiusFull}"
                    Background="{DynamicResource Primary}"
                    IsVisible="False" />
            <Border Name="StateLayer"
                    CornerRadius="{DynamicResource CornerRadiusFull}"
                    Background="{DynamicResource OnSurface}"
                    Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationShort2}" /></Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontSize="{TemplateBinding FontSize}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.08" />
      </Style>
      <Style Selector="^:pressed /template/ Border#StateLayer">
        <Setter Property="Opacity" Value="0.10" />
      </Style>

      <Style Selector="^:selected /template/ Border#SelectedBackground">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:selected /template/ Border#StateLayer">
        <Setter Property="Background" Value="{DynamicResource OnPrimary}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimary}" />
      </Style>

      <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurfaceVariant}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurface38}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

</Styles>

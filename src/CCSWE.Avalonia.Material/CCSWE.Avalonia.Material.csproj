<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>A standalone Material 3 theme for Avalonia 12 — a Dark/Light color system, the M3 type scale, motion, embedded brand fonts (DM Sans, Plus Jakarta Sans), and M3 control themes for the full control set. Depends only on Avalonia core (no Fluent/Simple base theme required); add &lt;theme:MaterialTheme /&gt; to Application.Styles.</Description>
    <PackageTags>avalonia;theme;material-design;material-3;m3;ui;xaml;dark-theme;controls</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ccswe-logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- VersionOverride widens the packed dependency to any 12.0.x so consumers on older
         12.0 patches (e.g. 12.0.3) can restore; CPM keeps the build/test pin at 12.0.4. -->
    <PackageReference Include="Avalonia" VersionOverride="[12.0.0, 13.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="ccswe-logo.png" Pack="true" PackagePath="/" />
    <None Include="Assets/Fonts/*-OFL.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES/" />
  </ItemGroup>

</Project>

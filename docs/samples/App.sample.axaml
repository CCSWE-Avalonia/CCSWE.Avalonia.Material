<!--
  =============================================================================
  HAND-AUTHORED DOC SNIPPET - not compiled, not emitted as a buildable file.
  Shows how a consuming app wires the CCSWE Avalonia Material theme. Copy the
  relevant bits into your own App.axaml (which has its own x:Class).
  =============================================================================

  NOTE: intentionally has NO x:Class - a theme library must not carry a
  consumer's application type, and an x:Class here would auto-glob into a
  consuming AXAML build and fail to resolve. Add your own x:Class in your app.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             RequestedThemeVariant="Dark">
  <!-- RequestedThemeVariant="Dark" makes dark the app default, matching web and
       the upstream design intent. Set "Light" or bind to a setting to switch;
       the theme's ThemeDictionaries respond automatically. -->

  <Application.Styles>
    <!-- One element: the standalone Material 3 theme. It supplies the whole
         control surface itself - no <FluentTheme/> or other base theme needed. -->
    <theme:MaterialTheme />
  </Application.Styles>
</Application>
